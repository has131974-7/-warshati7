generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum FuelLevel {
  FULL
  THREE_QUARTER
  HALF
  QUARTER
  LOW
  EMPTY
}

enum RepairOrderStatus {
  RECEIVED
  INSPECTION_PENDING
  CUSTOMER_APPROVAL_PENDING
  PARTS_PENDING
  IN_REPAIR
  QUALITY_CHECK
  READY_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum RepairItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED
}

enum OrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE_WALLET
  CHEQUE
  OTHER
}

enum AttachmentType {
  DOCUMENT
  IMAGE
  VIDEO
  PDF
  OTHER
}

enum VehiclePhotoType {
  EXTERIOR
  INTERIOR
  ODOMETER
  DAMAGE
  OTHER
}

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  username             String          @unique
  passwordHash         String
  displayName          String
  phone                String?
  status               UserStatus      @default(ACTIVE)
  lastLoginAt          DateTime?
  roles                UserRole[]
  technician           Technician?
  createdRepairOrders  RepairOrder[]   @relation("RepairOrderCreatedBy")
  createdPurchaseOrder PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  receivedPayments     Payment[]       @relation("PaymentReceivedBy")
  uploadedAttachments  Attachment[]
  capturedVehiclePhoto VehiclePhoto[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  users       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Technician {
  id             String        @id @default(cuid())
  userId         String        @unique
  employeeCode   String        @unique
  specialization String?
  isActive       Boolean       @default(true)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  repairOrders   RepairOrder[]
  repairItems    RepairItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  customerCode String        @unique
  fullName     String
  mobileNumber String
  email        String?
  address      String?
  notes        String?
  vehicles     Vehicle[]
  repairOrders RepairOrder[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([fullName])
  @@index([mobileNumber])
}

model Vehicle {
  id           String         @id @default(cuid())
  customerId   String
  plateNumber  String         @unique
  vin          String         @unique
  make         String
  model        String
  year         Int
  odometer     Int
  fuelLevel    FuelLevel      @default(HALF)
  color        String
  notes        String?
  customer     Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  repairOrders RepairOrder[]
  photos       VehiclePhoto[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([customerId])
  @@index([make, model])
}

model RepairOrder {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  customerId            String
  vehicleId             String
  createdById           String?
  assignedTechnicianId  String?
  status                RepairOrderStatus @default(RECEIVED)
  priority              OrderPriority     @default(MEDIUM)
  complaintDescription  String
  inspectionNotes       String?
  diagnosisNotes        String?
  estimatedDeliveryDate DateTime?
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  customer              Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle               Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy             User?             @relation("RepairOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTechnician    Technician?       @relation(fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  repairItems           RepairItem[]
  invoice               Invoice?
  attachments           Attachment[]
  vehiclePhotos         VehiclePhoto[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([assignedTechnicianId])
}

model RepairItem {
  id            String           @id @default(cuid())
  repairOrderId String
  technicianId  String?
  title         String
  description   String?
  quantity      Int              @default(1)
  unitPrice     Decimal          @default(0)
  discount      Decimal          @default(0)
  taxRate       Decimal          @default(0)
  lineTotal     Decimal          @default(0)
  status        RepairItemStatus @default(OPEN)
  repairOrder   RepairOrder      @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  technician    Technician?      @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([repairOrderId])
  @@index([technicianId])
}

model Supplier {
  id             String          @id @default(cuid())
  supplierCode   String          @unique
  name           String
  contactName    String?
  mobileNumber   String?
  email          String?
  address        String?
  isActive       Boolean         @default(true)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([name])
}

model InventoryItem {
  id                  String              @id @default(cuid())
  sku                 String              @unique
  name                String
  description         String?
  unitOfMeasure       String?
  quantityOnHand      Int                 @default(0)
  reorderLevel        Int                 @default(0)
  unitCost            Decimal             @default(0)
  salePrice           Decimal             @default(0)
  preferredSupplierId String?
  preferredSupplier   Supplier?           @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  purchaseOrderItems  PurchaseOrderItem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([name])
  @@index([preferredSupplierId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplierId   String
  createdById  String?
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  orderedAt    DateTime            @default(now())
  expectedDate DateTime?
  receivedAt   DateTime?
  totalAmount  Decimal             @default(0)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]
  attachments  Attachment[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String
  quantity        Int
  unitCost        Decimal       @default(0)
  lineTotal       Decimal       @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([purchaseOrderId, inventoryItemId])
  @@index([inventoryItemId])
}

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  repairOrderId  String        @unique
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @default(0)
  taxAmount      Decimal       @default(0)
  discountAmount Decimal       @default(0)
  totalAmount    Decimal       @default(0)
  issuedAt       DateTime?
  dueDate        DateTime?
  paidAt         DateTime?
  notes          String?
  repairOrder    RepairOrder   @relation(fields: [repairOrderId], references: [id], onDelete: Restrict)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments       Payment[]
  attachments    Attachment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  invoiceId     String
  receivedById  String?
  method        PaymentMethod
  amount        Decimal
  paidAt        DateTime      @default(now())
  referenceNo   String?
  notes         String?
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy    User?         @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceId])
  @@index([method])
}

model Attachment {
  id              String         @id @default(cuid())
  fileName        String
  fileUrl         String
  mimeType        String
  sizeBytes       Int
  storageProvider String         @default("local")
  attachmentType  AttachmentType @default(DOCUMENT)
  uploadedById    String?
  repairOrderId   String?
  purchaseOrderId String?
  invoiceId       String?
  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  repairOrder     RepairOrder?   @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  vehiclePhoto    VehiclePhoto?  @relation("VehiclePhotoAttachment")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([repairOrderId])
  @@index([purchaseOrderId])
  @@index([invoiceId])
}

model VehiclePhoto {
  id            String           @id @default(cuid())
  vehicleId     String
  repairOrderId String?
  capturedById  String?
  attachmentId  String?          @unique
  photoType     VehiclePhotoType @default(EXTERIOR)
  fileUrl       String
  caption       String?
  capturedAt    DateTime         @default(now())
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  repairOrder   RepairOrder?     @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)
  capturedBy    User?            @relation(fields: [capturedById], references: [id], onDelete: SetNull)
  attachment    Attachment?      @relation("VehiclePhotoAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([vehicleId])
  @@index([repairOrderId])
}
